    "6. Implement a triangle class analogous to the rectangle and circle in question 5."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Triangle(Shape):\n",
    "    def __init__(self, base, height, side3=None):\n",
    "        self._base = base\n",
    "        self._height = height\n",
    "        self._side3 = side3\n",
    "\n",
    "    def area(self):\n",
    "        return 0.5 * self._base * self._height\n",
    "\n",
    "    def perimeter(self):\n",
    "        if self._side3:\n",
    "            return self._base + self._height + self._side3\n",
    "        return None\n",
    "\n",
    "    def base(self):\n",
    "        return self._base\n",
    "\n",
    "    def height(self):\n",
    "        return self._height\n",
    "\n",
    "    def side3(self):\n",
    "        return self._side3"
   ]
