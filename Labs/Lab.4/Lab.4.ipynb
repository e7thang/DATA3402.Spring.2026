   "source": [
    "1. Write a \"counter\" class that can be incremented up to a specified maximum value, will print an error if an attempt is made to increment beyond that value, and allows reseting the counter. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Counter:\n",
    "    def __init__(self, max_value):\n",
    "        self.max = max_value\n",
    "        self.value = 0\n",
    "\n",
    "    def increment(self):\n",
    "        if self.value == self.max:\n",
    "            print(\"Max has been reached\")\n",
    "        else:\n",
    "            self.value += 1\n",
    "\n",
    "    def reset(self):\n",
    "        self.value = 0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0\n",
      "2\n",
      "Max has been reached\n",
      "0\n"
     ]
    }
   ],
   "source": [
    "c = Counter(2)\n",
    "\n",
    "print(c.value)\n",
    "\n",
    "c.increment()\n",
    "c.increment()\n",
    "print(c.value)\n",
    "\n",
    "c.increment()\n",
    "\n",
    "c.reset()\n",
    "print(c.value) "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "2. Copy and paste your solution to question 1 and modify it so that all the data held by the counter is private. Implement functions to check the value of the counter, check the maximum value, and check if the counter is at the maximum."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Counter:\n",
    "    def __init__(self, max_value):\n",
    "        self._value = 0\n",
    "        self._max = max_value\n",
    "\n",
    "    def increment(self):\n",
    "        if self._value < self._max:\n",
    "            self._value += 1\n",
    "        else:\n",
    "            print(\"Max has been reached\")\n",
    "\n",
    "    def reset(self):\n",
    "        self._value = 0\n",
    "\n",
    "    def value(self):\n",
    "        return self._value\n",
    "\n",
    "    def maximum(self):\n",
    "        return self._max\n",
    "\n",
    "    def at_max(self):\n",
    "        return self._value == self._max"
   ]
  },
