    "10. Copy the `Canvas` class from lecture to in a python file creating a `paint` module. Copy your classes from above into the module and implement paint functions. Implement a `CompoundShape` class. Create a simple drawing demonstrating that all of your classes are working."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 93,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Canvas:\n",
    "    def __init__(self, width, height):\n",
    "        self.width = width\n",
    "        self.height = height\n",
    "        # Empty canvas is a matrix with element being the \"space\" character\n",
    "        self.data = [[' '] * width for i in range(height)]\n",
    "\n",
    "    def set_pixel(self, row, col, char='*'):\n",
    "        self.data[row][col] = char\n",
    "\n",
    "    def get_pixel(self, row, col):\n",
    "        return self.data[row][col]\n",
    "    \n",
    "    def clear_canvas(self):\n",
    "        self.data = [[' '] * self.width for i in range(self.height)]\n",
    "    \n",
    "    def v_line(self, x, y, w, **kargs):\n",
    "        for i in range(x,x+w):\n",
    "            self.set_pixel(i,y, **kargs)\n",
    "\n",
    "    def h_line(self, x, y, h, **kargs):\n",
    "        for i in range(y,y+h):\n",
    "            self.set_pixel(x,i, **kargs)\n",
    "            \n",
    "    def line(self, x1, y1, x2, y2, **kargs):\n",
    "        slope = (y2-y1) / (x2-x1)\n",
    "        for y in range(y1,y2):\n",
    "            x= int(slope * y)\n",
    "            self.set_pixel(x,y, **kargs)\n",
    "            \n",
    "    def display(self):\n",
    "        print(\"\\n\".join([\"\".join(row) for row in self.data]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 104,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Shape:\n",
    "    def __init__(self, name=\"\", **kwargs):\n",
    "        self.name = name\n",
    "        self.kwargs = kwargs\n",
    "\n",
    "    def paint(self, canvas):\n",
    "        pass\n",
    "\n",
    "class Rectangle(Shape):\n",
    "    def __init__(self, x, y, w, h, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.x, self.y, self.w, self.h = x, y, w, h\n",
    "\n",
    "    def paint(self, canvas):\n",
    "        canvas.v_line(self.x, self.y, self.h, **self.kwargs)\n",
    "        canvas.v_line(self.x + self.w, self.y, self.h, **self.kwargs)\n",
    "        canvas.h_line(self.x, self.y, self.w, **self.kwargs)\n",
    "        canvas.h_line(self.x, self.y + self.h, self.w, **self.kwargs)\n",
    "\n",
    "class Circle(Shape):\n",
    "    def __init__(self, x, y, r, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.x, self.y, self.r = x, y, r\n",
    "\n",
    "    def paint(self, canvas):\n",
    "        import math\n",
    "        points = [(int(self.x + self.r*math.cos(2*math.pi*i/16)),\n",
    "                   int(self.y + self.r*math.sin(2*math.pi*i/16))) for i in range(16)]\n",
    "        for i in range(len(points)):\n",
    "            x1,y1 = points[i]\n",
    "            x2,y2 = points[(i+1)%len(points)]\n",
    "            canvas.line(x1,y1,x2,y2, **self.kwargs)\n",
    "\n",
    "class Triangle(Shape):\n",
    "    def __init__(self, x, y, base, height, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.x, self.y, self.b, self.h = x, y, base, height\n",
    "\n",
    "    def paint(self, canvas):\n",
    "        x1, y1 = self.x, self.y\n",
    "        x2, y2 = self.x + self.b, self.y\n",
    "        x3, y3 = self.x + self.b//2, self.y + self.h\n",
    "        canvas.line(x1,y1,x2,y2, **self.kwargs)\n",
    "        canvas.line(x2,y2,x3,y3, **self.kwargs)\n",
    "        canvas.line(x3,y3,x1,y1, **self.kwargs)\n",
    "\n",
    "class CompoundShape(Shape):\n",
    "    def __init__(self, shapes, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.shapes = shapes\n",
    "\n",
    "    def paint(self, canvas):\n",
    "        for s in self.shapes:\n",
    "            s.paint(canvas)"
   ]
